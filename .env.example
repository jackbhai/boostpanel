# ── Supabase (Real Backend) ─────────────────────────────
# 1. Free account: https://supabase.com → New Project
# 2. Project Settings → API → copy URL + anon public key
# 3. Copy this file to ".env" and paste values below
# 4. In Supabase: SQL Editor → run supabase/schema.sql then supabase/seed.sql
# 5. Auth → Providers → Email → turn OFF "Confirm email" (for class demo)
#
# If these are empty, the app auto-runs in DEMO MODE (browser storage).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
